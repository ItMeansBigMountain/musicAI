# Copy to .env and fill local values. Never commit secrets.

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_CALLBACK_URL=http://localhost:5000/login/

# Genius API
GENIUS_API_KEY=your_genius_api_key_here

# IBM Watson NLU
WATSON_API_KEY=your_watson_api_key
WATSON_SERVICE_URL=your_watson_service_url

# Flask App
FLASK_SECRET_KEY=your_flask_secret_key_here
MUSICAI_TOKEN_SECRET=use_a_long_random_secret_for_encrypted_provider_tokens
MUSICAI_TOKEN_DB=musicai_tokens.db
MUSICAI_PUBLIC_BASE_URL=http://localhost:5000
FLASK_ENV=development
FLASK_DEBUG=true

# App Configuration
APP_NAME=musicai
ENV=dev
CONTAINER_PORT=8080

# Apple Music / MusicKit
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key_or_path

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SoundCloud OAuth
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret

# Deezer OAuth
DEEZER_APP_ID=your_deezer_app_id
DEEZER_SECRET=your_deezer_secret

# Last.fm taste/history API
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_SHARED_SECRET=your_lastfm_shared_secret

# Open metadata / listening history
LISTENBRAINZ_TOKEN=your_listenbrainz_token

# Lyrics / recognition providers
MUSIXMATCH_API_KEY=your_musixmatch_api_key
AUDD_API_TOKEN=your_audd_api_token
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret

# Imgflip API (for meme generation)
IMGFLIP_USERNAME=your_imgflip_username
IMGFLIP_PASSWORD=your_imgflip_password
